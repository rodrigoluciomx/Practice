def find_even_index(arr):
    current = 0
    for index in range(len(arr)):
        current = index
        left = sum(arr[:current])
        rigt = sum(arr[(current+1):])
        if left == rigt:
            return current
    return -1

if __name__ == "__main__":
    arr = [20,10,-80,10,10,15,35]
    print(find_even_index(arr))
    